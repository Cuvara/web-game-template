{
  "name": "web-game-template",
  "version": "0.1.0",
  "description": "Web Game Factory \u2014 reusable game template",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "pnpm -r --filter \"./packages/*\" build && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --force",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "test": "vitest run --project unit --project integration",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test --project desktop --project mobile",
    "test:verify": "playwright test --project verify",
    "demo:poki:dev": "pnpm --filter @wgf-examples/poki-compliance-demo dev",
    "demo:poki:build": "pnpm --filter @wgf-examples/poki-compliance-demo build",
    "test:poki": "playwright test --config playwright.poki.config.ts",
    "audit:poki": "node scripts/verify/poki-audit.mjs --dist examples/poki-compliance-demo/dist",
    "facts": "node scripts/verify/collect-facts.mjs",
    "assert": "node scripts/verify/evaluate-assertions.mjs",
    "release:package": "node scripts/release/package.mjs",
    "release:manifest": "node scripts/release/make-manifest.mjs",
    "publish:prepare": "node scripts/publish/make-publication.mjs",
    "demo:yandex:dev": "vite --config examples/yandex-compliance-demo/vite.config.ts",
    "demo:yandex:build": "vite build --config examples/yandex-compliance-demo/vite.config.ts",
    "demo:yandex:preview": "vite preview --config examples/yandex-compliance-demo/vite.config.ts",
    "demo:yandex:audit": "node scripts/verify/yandex-audit.mjs --dir examples/yandex-compliance-demo/dist",
    "demo:yandex:package": "node scripts/release/yandex-archive.mjs --dir examples/yandex-compliance-demo/dist --out build/yandex/yandex-compliance-demo.zip",
    "demo:yandex:e2e": "playwright test -c examples/yandex-compliance-demo/playwright.config.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^2.1.8",
    "adm-zip": "^0.5.16",
    "eslint": "^9.17.0",
    "globals": "^17.12.0",
    "prettier": "^3.4.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.8",
    "yaml": "^2.6.1"
  },
  "dependencies": {
    "@wgf/analytics-sdk": "workspace:*",
    "@wgf/game-core": "workspace:*",
    "@wgf/pixi-framework": "workspace:*",
    "@wgf/platform-sdk": "workspace:*",
    "@wgf/three-framework": "workspace:*"
  }
}
