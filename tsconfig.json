{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    "types": ["vite/client"]
  },
  // Template sources only. Each example is type-checked against its own tsconfig.json by
  // scripts/typecheck-examples.mjs, so a checkout without examples/ still type-checks.
  "include": ["src", "tests", "scripts/build", "*.config.ts", "vitest.workspace.ts"],
  "exclude": ["node_modules", "dist"],
  "references": [
    { "path": "./packages/game-core" },
    { "path": "./packages/platform-sdk" },
    { "path": "./packages/analytics-sdk" },
    { "path": "./packages/pixi-framework" },
    { "path": "./packages/three-framework" }
  ]
}
