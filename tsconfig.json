{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    "types": ["vite/client"]
  },
  "include": [
    "src",
    "tests",
    "*.config.ts",
    "vitest.workspace.ts",
    "examples/*/src",
    "examples/*/vite.config.ts"
  ],
  "exclude": ["node_modules", "dist", "examples/*/dist"],
  "references": [
    { "path": "./packages/game-core" },
    { "path": "./packages/platform-sdk" },
    { "path": "./packages/analytics-sdk" },
    { "path": "./packages/pixi-framework" },
    { "path": "./packages/three-framework" }
  ]
}
